# Apache settings for the web root. On nginx, set the same headers in the server block.
Options -Indexes

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin"
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # Only this site's own scripts, styles and API, plus Google Fonts. No frame-ancestors, so any
  # site can embed the form; add "frame-ancestors https://your-site" to restrict that.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'"
</IfModule>
